# =============================================================================
# VARIABLES DE ENTORNO - BACKEND (FLASK + POSTGRESQL + JWT)
# Configurar en Render: Dashboard > Environment Variables
# =============================================================================

FLASK_APP=run.py
FLASK_DEBUG=0
PORT=5000

# Cadena de conexión a PostgreSQL (en Render o Neon/Supabase)
# Ejemplo Render: postgresql://usuario:password@dpg-xxxxx.oregon-postgres.render.com/mi_bd
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/barbarito

# Clave secreta para JWT
JWT_SECRET_KEY=clave-secreta-jwt-sistema-almacen-2026-seguro
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=28800

# URL de tu frontend en Vercel (o '*' para permitir cualquier origen)
FRONTEND_URL=https://tu-frontend.vercel.app,http://localhost:5173,http://localhost:5174
